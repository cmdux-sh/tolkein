# Copy to ~/.config/tolkeins/config.env (install.sh does this once).
# chmod 600. Never commit the filled-in file.

# https URL of the deployed Worker, with no path.
WORKER_URL=

# Secret created with: npx wrangler secret put WRITE_TOKEN
WRITE_TOKEN=

# CodexBar 0.80.0+. The collector runs `usage --provider <id> --json`
# and does not pass --source (auto is correct; warp rejects cli).
CODEXBAR_BIN=/opt/homebrew/bin/codexbar

# Comma-separated CodexBar provider ids.
# gemini and claudeplatform read Chrome cookies. Enable Chrome for Tolkeins Collector
# under System Settings → Privacy & Security → Files and Folders.
# cursor still needs a cursor.com sign-in. This collector does not perform that sign-in.
PROVIDERS=claude,codex,cursor,warp,grok

# Seconds to wait for each provider before recording a collector error.
CODEXBAR_TIMEOUT=90
