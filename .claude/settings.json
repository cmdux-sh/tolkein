{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/internal-ui-mcp\" ]; then \"$HOME/.local/bin/internal-ui-mcp\" hook; fi"
          }
        ]
      }
    ]
  }
}
